{
  "name": "wexample/symfony-preference",
  "description": "Preferences kept per owner — a user, or everybody — in the session or the database",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyPreference\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyPreference\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "doctrine/orm": "^3.0",
    "symfony/security-bundle": "^7.4 || ^8.0",
    "symfony/validator": "^7.4 || ^8.0",
    "wexample/symfony-api": ">=13.0.0",
    "wexample/symfony-helpers": ">=16.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}